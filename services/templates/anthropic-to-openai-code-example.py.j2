import os

{% if local_testing %}
# Local test path: the Mistral upstream speaks the OpenAI Chat Completions
# API, so call it directly with the OpenAI SDK.
from openai import OpenAI

client = OpenAI(
    base_url="{{ service_base_url }}/v1",
    api_key=os.environ["UNITYSVC_API_KEY"],
)
response = client.chat.completions.create(
    model="{{ routing_key.model }}",
    messages=[
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Say this is a test"},
    ],
)
print(response.choices[0].message.content)
{% else %}
# Through the UnitySVC gateway: speak the Anthropic Messages API with the
# anthropic SDK. The gateway's llm_translator converts your request to the
# OpenAI upstream and the response back to Anthropic format.
from anthropic import Anthropic

client = Anthropic(
    base_url="{{ service_base_url }}",
    api_key=os.environ["UNITYSVC_API_KEY"],
)
message = client.messages.create(
    model="{{ routing_key.model }}",
    max_tokens=64,
    messages=[{"role": "user", "content": "Say this is a test"}],
)
print(message.content[0].text)
{% endif %}
