{
{#- Model-family logo (unitysvc/unitysvc-data#60): the catalog row shows the
    model's own mark rather than the provider's — the model is what a customer
    recognises, and the provider is already named beside it. Resolved from the
    model id, so no per-model parameter is needed and the populate script
    cannot destroy it. A model the registry does not know resolves to null,
    which creates no document and leaves the provider logo in place, so the key
    needs no conditional. -#}
  "logo": {{ {"$logo_preset": offering_name} | tojson }},
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- Only chat (llm) services get the OpenAI/Anthropic dialect treatment; a
    translator/dual-formats on a non-chat service (e.g. embeddings) would be
    semantically wrong. #}
{%- set is_chat = service_type == 'llm' %}
{#- Marketplace summary (teaser, <=200 chars) + long-form description
    (the populate script emits a one-line brief). #}
{%- set _base = description | default(display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name, true) %}
{%- set _dual = ' — callable in both OpenAI and Anthropic API styles through the UnitySVC gateway.' %}
{%- set _brief = (_base ~ _dual) if ((_base | length) + (_dual | length) < 195) else _base %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details.context_length else '' %}
{#- Billing sentence, shared by both branches. "billed per token" used to sit
    here, which read as though UnitySVC metered the tokens; it does not — this
    is BYOK, the customer's own key pays the provider and the gateway price is
    zero. The upstream rate belongs in prose as well as in the price cell's
    hover note (see listing.json.j2): a `title` attribute is unreachable on
    touch, absent from the API and MCP catalog surfaces (`market_list_services`
    returns the description, not a rendered tooltip), and not searchable. For a
    BYOK listing that rate is the difference between "free" and real money. #}
{%- set _at_rate = (' at ' ~ pricing_note) if pricing_note else '' %}
{%- set _billing = ' Requests are proxied through the UnitySVC gateway; you bring your own ' ~ provider_display_name ~ ' API key, so token usage is billed by ' ~ provider_display_name ~ ' directly' ~ _at_rate ~ ', and the service is free through UnitySVC.' %}
{%- if is_chat %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' over an OpenAI-compatible API' ~ _ctx ~ '.' ~ _billing %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). See the code examples for both styles.' %}
{%- else %}
{%- set _detail = display_name ~ ' is a ' ~ service_type ~ ' service from ' ~ provider_display_name ~ _ctx ~ ', served over its native API.' ~ _billing %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). See the code examples for usage.' %}
{%- endif %}
{#- Dedicated interoperability paragraph: the dual-dialect endpoint is the
    platform differentiator and what makes services interchangeable enough to
    sit behind the gateway's composition primitives. #}
{%- set _interop = 'One endpoint, either dialect — send an OpenAI Chat Completions or an Anthropic Messages request and the gateway auto-detects the format, translates it for the upstream, and replies in the style you sent. Because every model on UnitySVC speaks both dialects, they are interchangeable behind a single client: swap providers without touching your code, and combine them with the gateway composition primitives — group (/g/), broadcast (/b/), chain (/c/) and failover (/f/).' %}
{%- set _description = _detail ~ '\n\n' ~ _howto ~ '\n\n' ~ _interop %}
  "summary": {{ _brief[:200] | tojson }},
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
{#- Platform capability vocabulary (unitysvc docs/capabilities.yml). Mapped from
    service_type rather than echoed: `_determine_service_type` in the populator
    classifies by model id and can emit embedding and rerank as well as llm.
    `vision_language_model` maps to chat — vision is an attribute of a chat call
    (an image in the request), not a capability of its own. -#}
{%- set _cap = {"llm": "chat", "embedding": "embed", "rerank": "rerank",
                "vision_language_model": "chat"}.get(service_type, "chat") %}
  "capabilities": {{ capabilities | default([_cap]) | tojson }},
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
{#- Tags come from the platform's CLOSED vocabulary (unitysvc docs/tags.yml).
    The legacy trio — "ai", "gateway", "byok" — is gone: each one restated a
    field the platform already derives (`service_type`, `gateway_type`, and the
    enrollment channel named in `upstream_access_config` below), and ingest now
    REJECTS any tag outside the vocabulary, so an upload carrying them fails
    outright. `feature:func-call` is the only tag a seller may declare.

    Keyed off a REAL per-model signal, not a catalog-wide assumption: Mistral's
    `GET /v1/models` returns a `capabilities` object on every model card
    (BaseModelCard.capabilities -> ModelCapabilities), and one of its fields is
    `function_calling`. scripts/update_params.py copies it verbatim into
    `supports_function_calling`, so this catalog advertises tool use per model,
    on Mistral's own answer, and follows the upstream when a model's answer
    changes.

    Absent (a param file written before the populator captured the field) or
    false renders NO tag — under-claiming until the next populate run rather
    than shipping a tool-calling example to a model that would 400 on it. The
    `is_chat` half keeps it off the embedding models, whose `capabilities`
    report `function_calling: false` anyway. -#}
  "tags": {{ (["feature:func-call"] if (is_chat and supports_function_calling) else []) | tojson }},
{#- Merge the dual-dialect formats into the provider's details (R8), chat only;
    the llm_translator below exposes the OpenAI upstream in both dialects. #}
{%- set _details = details.copy() %}
{%- if is_chat %}
{%- set _ = _details.update({"input_formats": ["openai", "anthropic"], "output_formats": ["openai_response", "anthropic_response"]}) %}
{%- endif %}
  "details": {{ _details | tojson }},
{%- if payout_price %}
  "payout_price": {{ payout_price | tojson }},
{%- endif %}
  "upstream_access_config": {
    "byok": {
      "access_method": "http",
      "base_url": "{{ api_base_url | replace('/v1', '') }}",
      "api_key": "${ customer_secrets.{{ env_api_key_name }} }",
      "rate_limits": [],
      "routing_key": {"model": "{{ offering_name }}"}{% if is_chat %},
      "request_transformer": {"llm_translator": "anthropic_to_openai"}{% endif %}
    }
  }
}
