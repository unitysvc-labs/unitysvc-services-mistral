#!/bin/bash
# Mistral is OpenAI-native; the UnitySVC gateway also accepts Anthropic-format
# requests and translates them (llm_translator). Local tests hit the OpenAI
# upstream directly; gateway tests speak Anthropic and exercise the translator.
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

{% if local_testing %}
curl --fail-with-body -sS "{{ service_base_url }}/v1/chat/completions" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d '{"model":"{{ routing_key.model }}","messages":[{"role":"user","content":"Say this is a test"}]}' \
  | grep -q '"choices"'
{% else %}
curl --fail-with-body -sS "{{ service_base_url }}/v1/messages" \
  -H "Content-Type: application/json" \
  -H "x-api-key: ${UNITYSVC_API_KEY}" \
  -H "anthropic-version: 2023-06-01" \
  -d '{"model":"{{ routing_key.model }}","max_tokens":64,"messages":[{"role":"user","content":"Say this is a test"}]}' \
  | grep -q '"stop_reason"'
{% endif %}
echo "ok"
